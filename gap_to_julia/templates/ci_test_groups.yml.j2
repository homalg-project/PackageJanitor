# Every group is tested in its own CI job, which tests only the listed files of docs/src.
# Every .md file in docs/src must be listed in a group.
# After editing this file, run `make gen` to update .github/workflows/Test.yml.
ci_test_groups:
  - group: default
{% if docs_src_md_file_names | length > 0 %}
    files:
{% for file in docs_src_md_file_names %}
      - {{ file }}
{% endfor %}
{% else %}
    files: []
{% endif %}
